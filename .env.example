# Market Pulse Terminal — environment sample.
#
#   cp .env.example .env    # from the repository root, then edit
#
# Never commit `.env`, and never paste keys into the frontend, logs or fixtures
# (AGENTS.md §4 rule 2). The backend is the only process that reads this file.
# SRS Appendix A lists the contract-level variables; the rest are the cadences and
# guards described in SRS §9 and §11.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# Live providers are opt-in, so a fresh clone and every test run stay offline.
# While this is false the API serves the recorded fixture in replay mode: every
# section is `stale` and `errors[]` carries the replay disclosure. Set it to true
# only after adding the provider keys below.
ENABLE_LIVE_DATA=false

HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_TIMEOUT_SECONDS=8

# ---------------------------------------------------------------------------
# Provider credentials (server-side only)
# ---------------------------------------------------------------------------
# Alpaca (paper account is enough): status, movers and the ETF-proxy fallback.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex                     # iex (real-time, IEX only) | sip (15-min delayed)

# Finnhub: headlines and market status.
FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# Failover order per capability (SRS §4.1)
# ---------------------------------------------------------------------------
PROVIDER_ORDER_INDEXES=yfinance,alpaca
PROVIDER_ORDER_MOVERS=alpaca,yfinance
PROVIDER_ORDER_NEWS=finnhub,alpaca
PROVIDER_ORDER_STATUS=alpaca,finnhub,calendar

# ---------------------------------------------------------------------------
# Rate limits and circuit breaker (70% of documented quotas, provider-notes §3)
# ---------------------------------------------------------------------------
ALPACA_RATE_PER_MINUTE=140
FINNHUB_RATE_PER_MINUTE=42
YFINANCE_MIN_INTERVAL_SECONDS=15
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# Snapshot
# ---------------------------------------------------------------------------
INDEX_SYMBOLS=^GSPC,^IXIC,^DJI,^RUT,^VIX
SPARKLINE_POINTS=140

# ---------------------------------------------------------------------------
# Market mood (SRS §10, docs/sentiment.md §8)
# ---------------------------------------------------------------------------
SENTIMENT_WEIGHTS=volatility=0.30,trend=0.25,momentum=0.20,riskAppetite=0.15,headlineTone=0.10
SENTIMENT_BANDS=bearish=25,uncertain=44,neutral=60
SENTIMENT_MIN_COMPONENTS=3
ENABLE_HEADLINE_TONE=true
ENABLE_LLM_SUMMARY=false

# ---------------------------------------------------------------------------
# Refresh cadences in seconds (SRS §9): regular session, off-hours, closed
# ---------------------------------------------------------------------------
REFRESH_COOLDOWN_SECONDS=10
QUOTES_REFRESH_SECONDS=20
QUOTES_REFRESH_SECONDS_OFFHOURS=60
QUOTES_REFRESH_SECONDS_CLOSED=900
MOVERS_REFRESH_SECONDS=60
MOVERS_REFRESH_SECONDS_OFFHOURS=180
MOVERS_REFRESH_SECONDS_CLOSED=1800
NEWS_REFRESH_SECONDS=300
NEWS_REFRESH_SECONDS_OFFHOURS=600
NEWS_REFRESH_SECONDS_CLOSED=1800
STATUS_REFRESH_SECONDS=60
HISTORY_REFRESH_SECONDS=3600
SCHEDULER_JITTER_FRACTION=0.10
SCHEDULER_MAX_BACKOFF_SECONDS=300

# ---------------------------------------------------------------------------
# Movers filters (FR-7)
# ---------------------------------------------------------------------------
MOVERS_MIN_PRICE=1.00
MOVERS_MIN_VOLUME=100000
MOVERS_EXCLUDE_WARRANTS=true
MOVERS_EXCLUDE_LEVERAGED_ETFS=true

# ---------------------------------------------------------------------------
# Static export (FR-17): writes a schema-valid market-data.json for static hosting
# ---------------------------------------------------------------------------
ENABLE_STATIC_EXPORT=false
STATIC_EXPORT_PATH=frontend/public/market-data.json

# ---------------------------------------------------------------------------
# Charts (SRS §4.4, docs/tradingview.md)
# ---------------------------------------------------------------------------
CHART_ENGINE=lightweight            # lightweight | advanced
CHART_RESOLUTIONS=1,5,15,60,1D
CHART_LIVE_SUBSCRIPTION_CAP=10
CHART_HISTORY_CACHE_SECONDS=300
ENABLE_TRADINGVIEW_WIDGET=false

# ---------------------------------------------------------------------------
# Persistence and browser access
# ---------------------------------------------------------------------------
# Leave DATABASE_PATH unset: the default resolves to <repo>/backend/data/mpt.sqlite3,
# which is git-ignored and created on first write. A relative path here is resolved
# against the process working directory, which differs inside the container.
# DATABASE_PATH=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
